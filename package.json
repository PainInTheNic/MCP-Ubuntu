{
  "name": "ubuntu-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for managing Ubuntu servers over SSH — health checks, services, logs, updates, and commands, from a Claude conversation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ubuntu-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "servers.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ubuntu",
    "ssh",
    "devops",
    "server-management"
  ],
  "author": "PainInTheNic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PainInTheNic/MCP-Ubuntu.git"
  },
  "homepage": "https://github.com/PainInTheNic/MCP-Ubuntu#readme",
  "bugs": {
    "url": "https://github.com/PainInTheNic/MCP-Ubuntu/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ssh2": "^1.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
